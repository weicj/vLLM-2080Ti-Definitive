+def flashqla_legacy_chunk_gated_delta_rule(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: torch.Tensor,
+    output_final_state: bool,
+    use_qk_l2norm_in_kernel: bool = True,
+):
+    """Run the forward-only FlashQLA kernel used by SM70/SM75 builds."""
+    from vllm_sm75_flashqla import chunk_gated_delta_rule_fwd_legacy
+
+    if use_qk_l2norm_in_kernel:
+        q = l2norm_fwd(q)
+        k = l2norm_fwd(k)
+
+    output_dtype = v.dtype
+    state_dtype = initial_state.dtype
+    qkv_dtype = torch.float16
+    scale = q.shape[-1] ** -0.5
+    output, final_state = chunk_gated_delta_rule_fwd_legacy(
+        q.to(qkv_dtype).contiguous(),
+        k.to(qkv_dtype).contiguous(),
+        v.to(qkv_dtype).contiguous(),
+        g.to(torch.float32).contiguous(),
+        beta.to(torch.float32).contiguous(),
+        scale,
+        initial_state.to(torch.float32).contiguous(),
+    )
+    output = output.to(output_dtype)
+    if output_final_state:
+        final_state = final_state.to(state_dtype)
+    else:
+        final_state = None
+    return output, final_state
+
+
+def flashqla_legacy_varlen_chunk_gated_delta_rule(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: torch.Tensor,
+    output_final_state: bool,
+    cu_seqlens: torch.Tensor,
+    use_qk_l2norm_in_kernel: bool = True,
+):
+    """Run a packed varlen prefill as one FlashQLA CUDA batch."""
+    from vllm_sm75_flashqla import chunk_gated_delta_rule_fwd_legacy_varlen
+    if use_qk_l2norm_in_kernel:
+        q = l2norm_fwd(q)
+        k = l2norm_fwd(k)
+
+    output_dtype = v.dtype
+    state_dtype = initial_state.dtype
+    qkv_dtype = torch.float16
+    scale = q.shape[-1] ** -0.5
+    output, final_state = chunk_gated_delta_rule_fwd_legacy_varlen(
+        q.to(qkv_dtype).contiguous(),
+        k.to(qkv_dtype).contiguous(),
+        v.to(qkv_dtype).contiguous(),
+        g.to(torch.float32).contiguous(),
+        beta.to(torch.float32).contiguous(),
+        cu_seqlens.contiguous(),
+        scale,
+        initial_state.to(torch.float32).contiguous(),
+    )
+    output = output.to(output_dtype)
+    if output_final_state:
+        final_state = final_state.to(state_dtype)
+    else:
+        final_state = None
+    return output, final_state
+
